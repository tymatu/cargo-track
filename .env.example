# Copy to .env and adjust. Never commit .env!
DB_NAME=cargotrack
DB_USER=cargotrack
DB_PASSWORD=cargotrack
# 5433, чтобы не конфликтовать с локально установленным PostgreSQL на 5432
DB_PORT=5433

PGADMIN_EMAIL=admin@cargotrack.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Backend (Spring Boot)
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
