# Copy to .env and adjust. Never commit .env.
DB_NAME=cargotrack
DB_USER=cargotrack
DB_PASSWORD=local-demo-db-password-change-me
# Dev database host port.
DB_PORT=5433

PGADMIN_EMAIL=admin@cargotrack.local
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password
PGADMIN_PORT=5050

# Backend. Keep this long and random for any shared environment.
JWT_SECRET=local-demo-jwt-secret-local-demo-jwt-secret-local-demo-jwt-secret-123456
CORS_ALLOWED_ORIGINS=http://localhost:8088
OSRM_ENABLED=true
SPRING_PROFILES_ACTIVE=prod,demo
SIMULATION_ENABLED=true
SIMULATION_TIME_SCALE=6
DEMO_SEED_ENABLED=true
DEMO_LIFE_ENABLED=true

# Local Docker app.
APP_PORT=8088
